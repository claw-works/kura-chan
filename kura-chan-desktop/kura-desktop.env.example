# Kura-chan 桌面端运行环境变量模板
# 复制为 kura-desktop.env 并填入真实值（kura-desktop.env 已 gitignore，勿提交密钥）
#   cp kura-desktop.env.example kura-desktop.env

# server WebSocket 地址（设备连接用）
KURA_WS_URL=ws://127.0.0.1:18099/ws/device

# server HTTP 地址（拉立绘 PNG 用）
KURA_HTTP_BASE=http://127.0.0.1:18099

# 设备 api_key —— 需在 server 上注册过对应 actor（同固件鉴权方式）。绝不入 git。
KURA_API_KEY=

# 设备 id（一台设备 = 一个 actor）
KURA_DEVICE_ID=KURA_DESKTOP_001
