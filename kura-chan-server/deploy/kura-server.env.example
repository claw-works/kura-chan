# Kura-chan 服务端运行环境变量模板
# 用法：复制为 kura-server.env 并填入真实值（该文件已被 .gitignore 忽略，勿提交密钥）
#   cp kura-server.env.example kura-server.env

# 火山（豆包）API Key —— 绝不入 git
VOLC_API_KEY=

# AgentCore harness ARN（账号相关，不入 git；从 ~/.hare/.env 取）
HARNESS_ARN=

# ── LLM provider ──────────────────────────────────────────────
# 模型后端格式。已实现: bedrock-harness(默认, 用上面的 HARNESS_ARN + AWS) / openai-chat
# 待实现: bedrock-converse / openai-responses / anthropic-messages
# LLM_FORMAT=bedrock-harness
#
# openai-chat(DeepSeek / OpenAI 兼容接口)需以下三项, 取消注释并填值:
# LLM_FORMAT=openai-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-pro          # 或 deepseek-v4-flash(更快) / deepseek-chat
#
# 调参(env 优先于 config/default.toml; 留空则用 default.toml 的值):
# LLM_HISTORY_TURNS=20               # 传给无状态 provider 的历史轮数
# LLM_THINKING=false                 # DeepSeek v4: false=关闭思考(更快/更省) true=开启
# LLM_MAX_TOKENS=4096                # 输出上限
# LLM_TEMPERATURE=0.8

# PostgreSQL 连接串（成长/状态持久化，server 启动必需）
DATABASE_URL=postgresql://USER:PASS@localhost:5432/kura

# AWS 区域与凭证 profile（EC2 上可用实例角色，无需 profile）
AWS_REGION=us-west-2
# AWS_PROFILE=default

# 监听端口（公网 EC2 安全组放开的是 8866）
KURA_SERVER_PORT=8866

# Admin 页面 token（/ui/admin 改提示词/数值需要）。设强随机值，勿用弱口令；
# DMZ/公网暴露时尤其注意，建议测完即清或仅内网访问。留空则 admin 接口全部 403。
ADMIN_TOKEN=

# 日志级别
RUST_LOG=info,kura_chan_server=debug
